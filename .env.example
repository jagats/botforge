# ------------------------------------------------------------------
# AI Bot-as-a-Service Platform — Environment Variables (example)
# Copy this file to ".env" in the project root, then fill in real
# values. Never commit the real ".env" file to git.
# ------------------------------------------------------------------

# ---------------- Postgres ----------------
POSTGRES_USER=aibot_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=aibot_platform
POSTGRES_PORT=5432
# Full connection string the backend actually uses (built from the
# values above inside docker-compose.yml — you usually don't need
# to set this yourself for local dev).
DATABASE_URL=postgresql+psycopg://aibot_user:change_me_locally@postgres:5432/aibot_platform

# ---------------- Qdrant (vector database) ----------------
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=document_chunks

# ---------------- Backend (FastAPI) ----------------
BACKEND_PORT=8000
# Long random string — used to sign JWT tokens for dashboard logins.
# Generate one with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# ---------------- LLM provider (used by services/llm.py) ----------------
# Set whichever provider you're calling from services/llm.py.
OPENAI_API_KEY=sk-replace-me
# Embedding model used at ingestion time and at query time — must be
# the SAME model both places, or search results won't make sense.
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o

# ---------------- Frontend (Next.js dashboard) ----------------
FRONTEND_PORT=3000
# Must be reachable from the visitor's browser, so use localhost
# (not the "backend" Docker service name) for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------- File uploads ----------------
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=/app/uploads

# ---------------- Rate Limiting (Phase 5) ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WIDGET_PER_MINUTE=60
RATE_LIMIT_WIDGET_IP_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=15

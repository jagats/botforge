{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false
  },
  "include": ["src/**/*"]
}

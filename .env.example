# ------------------------------------------------------------------
# AI Bot-as-a-Service Platform — Environment Variables (example)
# Copy this file to ".env" in the project root, then fill in real
# values. Never commit the real ".env" file to git.
# ------------------------------------------------------------------

# ---------------- Postgres ----------------
POSTGRES_USER=aibot_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=aibot_platform
POSTGRES_PORT=5432
# Full connection string the backend actually uses (built from the
# values above inside docker-compose.yml — you usually don't need
# to set this yourself for local dev).
DATABASE_URL=postgresql+psycopg://aibot_user:change_me_locally@postgres:5432/aibot_platform
# Connection pool per worker. Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) * workers below
# Postgres max_connections (default 100). With 4 gunicorn workers: 10 * 4 = 40.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---------------- Qdrant (vector database) ----------------
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=document_chunks
# Minimum similarity score for a retrieved chunk to be used (0.0 = keep all).
# Consider ~0.2-0.3 in production to drop weak matches.
RETRIEVAL_MIN_SCORE=0.0
# API key protecting Qdrant. Leave EMPTY for local dev (no auth).
# REQUIRED in production — generate with: openssl rand -hex 32
# The same value is passed to the qdrant container (QDRANT__SERVICE__API_KEY).
QDRANT_API_KEY=

# ---------------- Backend (FastAPI) ----------------
BACKEND_PORT=8000
# Long random string — used to sign JWT tokens for dashboard logins.
# Generate one with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Short-lived superadmin impersonation session.
IMPERSONATION_EXPIRE_MINUTES=30
# Deliver the access token ONLY via HttpOnly cookie (recommended false in production
# so XSS cannot read it). true keeps it in the JSON body for API clients/tests.
EXPOSE_TOKEN_IN_BODY=true
ENVIRONMENT=development

# ---------------- LLM provider (used by services/llm.py) ----------------
# Set whichever provider you're calling from services/llm.py.
OPENAI_API_KEY=sk-replace-me
# Embedding model used at ingestion time and at query time — must be
# the SAME model both places, or search results won't make sense.
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o
# Set to true ONLY for local dev/tests without a real OpenAI key — returns
# deterministic mock embeddings/answers. MUST be false in production, where
# any OpenAI failure then raises instead of silently returning fake data.
USE_MOCK_AI=false

# ---------------- Frontend (Next.js dashboard) ----------------
FRONTEND_PORT=3000
# Must be reachable from the visitor's browser, so use localhost
# (not the "backend" Docker service name) for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------- File uploads ----------------
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=/app/uploads
# Max bytes read when fetching a remote URL for ingestion (SSRF/DoS guard).
MAX_FETCH_BYTES=5242880
# Reject PDFs with more than this many pages (decompression-bomb guard).
MAX_PDF_PAGES=500

# ---------------- Rate Limiting (Phase 5) ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WIDGET_PER_MINUTE=60
RATE_LIMIT_WIDGET_IP_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_CHAT_PER_MINUTE=30
# Shared store for rate limits + login lockout. Empty = per-process in-memory (dev only).
# In production set e.g. redis://redis:6379/0 so limits hold across all workers.
REDIS_URL=
REDIS_PORT=6379
# Number of trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For
# (dev / direct). Set to 1 when exactly one nginx/ALB is in front (prevents IP spoofing).
TRUSTED_PROXY_HOPS=0

# ---------------- Login brute-force protection ----------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------- RBAC & Superadmin Onboarding (Phase 6) ----------------
SUPERADMIN_EMAIL=admin@botforge.com
SUPERADMIN_PASSWORD=Admin@BotForge2026!
